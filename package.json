{
  "name": "varnick",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "postinstall": "sh scripts/use-tracked-git-hooks.sh",
    "dev": "bun run --filter @varnick/core dev",
    "dev:app": "bun run packages/core/scripts/dev.ts",
    "build": "bun run --filter @varnick/core build",
    "drive": "bun run --filter @varnick/core drive",
    "secret": "bun run packages/harness/src/secrets-cli.ts",
    "probe": "bun run packages/harness/src/probe-cli.ts",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "./packages/lint/node_modules/.bin/eslint .",
    "test": "bun test packages"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "latest",
    "typescript": "7"
  }
}
