<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for `make install`: @LABEL@, @ROOT@, @DB@ and @LOG@ are filled in by sed. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>
    <key>ProgramArguments</key>
    <array>
        <string>@ROOT@/.build/release/Launchy</string>
    </array>
    <!-- The repo, so .env and the Claude session directory resolve as under `make run`. -->
    <key>WorkingDirectory</key>
    <string>@ROOT@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LAUNCHY_DB</key>
        <string>@DB@</string>
    </dict>
    <!-- Start at login only: no KeepAlive, so Quit from the menu bar stays quit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
