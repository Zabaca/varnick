<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime lets Varnick do beyond its default, and nothing else. Add an entitlement only for a failure seen, with a comment saying which. -->
<plist version="1.0">
<dict>
	<!-- The microphone (Listening). The hardened runtime refuses it without this. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
