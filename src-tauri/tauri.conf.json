{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "varnick",
  "version": "0.0.0",
  "identifier": "com.zabaca.varnick",
  "build": {
    "frontendDist": "../packages/core/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --filter @varnick/core dev",
    "beforeBuildCommand": "bun run --filter @varnick/core build"
  },
  "app": {
    "windows": [
      {
        "title": "varnick",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
