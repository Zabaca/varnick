# Dependencies
node_modules/

# Build output
dist/
build/
target/
.turbo/
*.tsbuildinfo

# Test and coverage output
coverage/

# Environment and secrets — never commit these
.env
.env.*
!.env.example

# Impeccable local-only state (config.json is shared and tracked)
.impeccable/config.local.json
.impeccable/sketches/

# OS and editor noise
.DS_Store
*.log

# Specs and tickets under .scratch/ are tracked deliberately — see
# docs/agents/issue-tracker.md. Do not add .scratch/ here.

# The sandbox policy is generated into the clone on first launch and holds
# absolute paths for one machine. Read it, edit it, do not commit it — the
# generator in packages/harness/src/sandbox.ts is what a fork changes.
/sandbox-policy.json

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Worktrees for parallel ticket agents. Checkouts, not history.
/.claude/worktrees/
